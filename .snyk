# Temporary exceptions for advisories in server-only LiteLLM Proxy/SSO paths.
# OIG uses its own outbound OpenAI-compatible HTTP client and never starts
# LiteLLM Proxy or its SSO endpoints. Re-evaluate before the expiry date.
version: v1.25.0
ignore:
  SNYK-PYTHON-LITELLM-17391451:
    - '*':
        reason: >-
          OIG uses an outbound client and never starts LiteLLM Proxy or its SSO
          server; the affected Proxy/SSO authentication path is unreachable.
